{
  "name": "rsp-documents-service",
  "version": "4.0.9",
  "description": "",
  "repository": "<replace>",
  "author": "",
  "license": "MIT",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "scripts": {
    "start": "npm run copy-localfiles && npm run compile && npm run parallel",
    "start:local": "npm start",
    "presetup": "npm run copy-localfiles",
    "copy-localfiles": "npm run copy-sls && npm run copy-env && npm run copy-mockdata && npm run copy-models && npm run copy-openapi",
    "copy-sls": "./node_modules/.bin/copyfiles -f serverless/*.yml build",
    "copy-mockdata": "./node_modules/.bin/copyfiles mock-data/*.json build && npm run seed:integration:generate",
    "seed:integration:generate": "node scripts/generate-local-seed.cjs",
    "copy-models": "./node_modules/.bin/copyfiles -f src/models/*.json build/models",
    "copy-package": "./node_modules/.bin/copyfiles package.json build/",
    "copy-env": "./node_modules/.bin/copyfiles .env build/",
    "copy-openapi": "./node_modules/.bin/copyfiles openapiReplace.js build/",
    "deploy-AWS": "npm run copy-package && npm run copy-sls && cd ./build && npm install --production && sls deploy",
    "parallel": "./node_modules/.bin/run-p watch offline",
    "watch": "./node_modules/.bin/nodemon --watch src --exec npm run compile",
    "compile": "./node_modules/.bin/babel src -d build",
    "offline": "cd ./build && node --env-file=.env ../node_modules/serverless/bin/serverless.js offline start --noAuth",
    "test": "node --no-experimental-detect-module ./node_modules/mocha/bin/mocha.js --require ./src/test/setup.cjs --require @babel/register --recursive \"src/**/*.unit.js\"",
    "test:coverage": "BABEL_ENV=coverage nyc npm test",
    "test-i": "./node_modules/.bin/mocha --require @babel/register src/test/**/*.serviceInt.js",
    "test:integration:local": "node --env-file=.env integration/run.cjs",
    "test:integration:seed": "node --env-file=.env integration/run.cjs seed",
    "test:integration:reset": "node --env-file=.env integration/run.cjs reset",
    "test:integration:report": "node integration/run.cjs report",
    "test:integration:report:open": "node integration/open-report.cjs",
    "test:integration:approve-sites": "node integration/approve-sites.cjs",
    "test:integration:tooling": "node --test integration/tooling.test.cjs",
    "lint:integration": "eslint --ext .cjs integration scripts/generate-local-seed.cjs",
    "lint": "./node_modules/.bin/eslint src",
    "lint:fix": "./node_modules/.bin/eslint src --fix",
    "build-openapi": "npm run compile && npm run copy-localfiles && cd build && sls openapi generate -f json && node openapiReplace.js",
    "openapireplace": "node openapiReplace.js",
    "start-build": "rm -rf build && npm run copy-localfiles && npm run compile && npm run copy-package && npm run build-node-modules && npm run post-build-cleanup && npm run build-artifact && rm -f build/serverless.yml",
    "build-node-modules": "cd build && npm install --production",
    "build-artifact": "cd build && rm -rf artifacts && pwd && sls package --package artifacts",
    "post-build-cleanup": "rm -rf build/mock-data && rm -f build/package.json && rm -f build/openApiReplace.js && rm -f build/package-lock.json",
    "prepush": "npm run check-js-types && npm test && npm run lint && npm run check-security && npm run check-security-log",
    "check-security": "git secrets --scan",
    "check-security-log": "git log -p | scanrepo",
    "check-js-types": "tsc --noEmit -p .",
    "package": "webpack-cli --config webpack.production.js"
  },
  "devDependencies": {
    "@babel/cli": "^7.21.0",
    "@babel/core": "^7.21.0",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-transform-runtime": "^7.21.0",
    "@babel/preset-env": "^7.20.2",
    "@babel/preset-typescript": "^7.21.0",
    "@babel/register": "^7.21.0",
    "@types/node": "^24.0.0",
    "archiver": "^5.3.1",
    "babel-loader": "^9.1.2",
    "babel-plugin-istanbul": "^7.0.0",
    "copyfiles": "^2.4.1",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.27.5",
    "expect": "^29.5.0",
    "fs-extra": "^11.1.0",
    "lodash": "^4.17.21",
    "mocha": "^12.0.3",
    "nodemon": "^3.1.4",
    "npm-run-all": "^4.1.5",
    "nyc": "^17.1.0",
    "replace": "^1.2.2",
    "rimraf": "^4.4.0",
    "osls": "^4.4.0",
    "serverless": "npm:osls@^4.4.0",
    "serverless-dotenv-plugin": "^6.0.0",
    "serverless-dynamodb": "^0.2.58",
    "serverless-offline": "^14.8.4",
    "serverless-openapi-documenter": "^0.1.7",
    "sinon": "^15.0.1",
    "supertest": "^6.3.3",
    "typescript": "^5.9.3",
    "webpack": "^5.112.2",
    "webpack-cli": "^5.1.4",
    "webpack-merge": "^6.0.1"
  },
  "dependencies": {
    "@babel/runtime-corejs3": "^7.21.0",
    "@dvsa/rsp-validation": "^4.0.1",
    "@aws-sdk/client-dynamodb": "^3.1156.0",
    "@aws-sdk/client-lambda": "^3.1156.0",
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/client-secrets-manager": "^3.1156.0",
    "@aws-sdk/client-sns": "^3.1156.0",
    "@aws-sdk/lib-dynamodb": "^3.1156.0",
    "@aws-sdk/util-dynamodb": "^3.996.9",
    "core-js": "^3.29.0",
    "install": "^0.13.0",
    "js-sha256": "^0.9.0",
    "uuid": "^11.1.1"
  },
  "overrides": {
    "serverless": "$serverless",
    "serverless-openapi-documenter": {
      "js-yaml": "^4.3.2",
      "nanoid": "^3.3.17",
      "yaml": "^1.10.3"
    }
  }
}
