{
  "compilerOptions": {
    "target": "es6",
    "lib": ["es7"],
    "module": "commonjs",
    "resolveJsonModule": true,
    "checkJs": true,
    "allowJs": true,
    "noEmit": true
  },
  "exclude": [
    "node_modules",
    "src/test",
    "integration",
    "integration-reports",
    "**/*.unit.js",
    "coverage",
    ".nyc_output",
    "build",
    "mock-data"
  ]
}
